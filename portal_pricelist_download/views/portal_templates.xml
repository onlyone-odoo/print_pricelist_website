<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="portal_my_home_pricelist_download" inherit_id="portal.portal_my_home" name="Portal Home - Pricelist Download Link">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-if="show_pricelist_download">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="url">/my/pricelist/download</t>
                    <t t-set="title">Price List (XLSX)</t>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
