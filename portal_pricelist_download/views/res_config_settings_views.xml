<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_portal_pricelist" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.portal.pricelist</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='website']" position="inside">
                <block title="Descarga de lista en portal" id="portal_pricelist_download_block">
                    <setting id="portal_pricelist_download_setting" help="Permitir que los usuarios del portal descarguen su lista de precios en XLSX desde Mi cuenta.">
                        <field name="portal_pricelist_download"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
