<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_portal_pricelist" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.portal.pricelist</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Portal Pricelist" name="portal_pricelist_download">
                    <block title="Pricelist Download" name="portal_pricelist_download_block">
                        <setting id="portal_pricelist_download_setting" help="Allow portal users to download their pricelist in XLSX from My Account.">
                            <field name="portal_pricelist_download" />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
