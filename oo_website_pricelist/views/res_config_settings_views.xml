<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_website_pricelist" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.website.pricelist</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='website']" position="inside">
                <block title="Lista de precios web (/lista)" id="oo_website_pricelist_block">
                    <setting help="Lista que se muestra en la primera columna de precios.">
                        <field name="website_pricelist_primary_id"/>
                    </setting>
                    <setting help="Opcional: si se elige una lista, se muestra una segunda columna de precios.">
                        <field name="website_pricelist_secondary_id"/>
                    </setting>
                    <setting help="Desactivar para ocultar la columna con enlaces al ecommerce en /lista.">
                        <field name="website_pricelist_show_shop_link"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
